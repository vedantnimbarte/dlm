{
 "architectures": [
  "Gemma3ForConditionalGeneration"
 ],
 "model_type": "gemma3",
 "torch_dtype": "float16",
 "mm_tokens_per_image": 4,
 "boi_token_index": 60,
 "eoi_token_index": 61,
 "image_token_index": 62,
 "text_config": {
  "model_type": "gemma3_text",
  "vocab_size": 64,
  "hidden_size": 32,
  "intermediate_size": 64,
  "num_hidden_layers": 2,
  "num_attention_heads": 2,
  "num_key_value_heads": 1,
  "head_dim": 16,
  "query_pre_attn_scalar": 16,
  "hidden_activation": "gelu_pytorch_tanh",
  "max_position_embeddings": 64,
  "rms_norm_eps": 1e-06,
  "rope_theta": 10000.0,
  "rope_local_base_freq": 1000.0,
  "rope_scaling": {
   "rope_type": "linear",
   "factor": 2.0
  },
  "sliding_window": 6,
  "layer_types": [
   "sliding_attention",
   "full_attention"
  ],
  "bos_token_id": 2,
  "eos_token_id": 1,
  "pad_token_id": 0,
  "tie_word_embeddings": true
 },
 "vision_config": {
  "model_type": "siglip_vision_model",
  "hidden_size": 32,
  "intermediate_size": 48,
  "num_hidden_layers": 2,
  "num_attention_heads": 2,
  "image_size": 28,
  "patch_size": 7,
  "layer_norm_eps": 1e-06,
  "hidden_act": "gelu_pytorch_tanh",
  "vision_use_head": false
 }
}