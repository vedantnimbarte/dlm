# Shell scripts are curl|sh'd by users; a CRLF checkout on Windows makes `sh`
# choke on `set -eu\r`. Force LF regardless of the contributor's autocrlf.
*.sh text eol=lf

# Test fixtures are binary GGUF files; never touch their bytes.
*.gguf binary

# Docker reads these on Linux: a CRLF line continuation breaks a RUN.
Dockerfile text eol=lf
.dockerignore text eol=lf
